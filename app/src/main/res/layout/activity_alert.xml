<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert Feed"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ Sudden turbidity seen in Stream A — Please check before using."
            android:textSize="18sp"
            android:padding="16dp"
            android:layout_marginTop="30dp"
            android:background="#FFFFFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ Low water flow detected near Sacred Spring Zone."
            android:textSize="18sp"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠ Pollution report received from Village Stream B."
            android:textSize="18sp"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"/>

    </LinearLayout>

</ScrollView>