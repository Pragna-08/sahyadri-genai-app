<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DFF6E3">

    <!-- TOP TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="#0B5D3B"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Logo -->
            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="💧"
                android:textSize="24sp"
                android:background="@drawable/bg_avatar_circle" />

            <!-- App Name -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Sahyadri-Siri"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- User -->
            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="JD"
                android:textStyle="bold"
                android:textColor="#0B5D3B"
                android:textSize="14sp"
                android:background="#C8E6C9" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- AI INSIGHT CARD -->
    <LinearLayout
        android:id="@+id/aiCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:layout_margin="16dp"
        android:background="#FFF3CD"
        android:orientation="horizontal"
        android:padding="16dp"
        android:elevation="3dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="⚠"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIRI AI INSIGHT"
                android:textColor="#0B5D3B"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAiInsight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyzing stream health trends..."
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- MAP AREA -->
    <LinearLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="430dp"
        android:layout_below="@id/aiCard"
        android:layout_above="@id/bottomNav"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="#A5D6A7"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Community Water Health Map"
            android:textColor="#0B5D3B"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_gravity="center_horizontal" />

        <!-- MAP CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="14dp"
            android:background="#E8F5E9"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Stream Monitoring Zones"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#BBDEFB"
                android:padding="14dp"
                android:text="🔵 Stream A — Clean Zone\nHigh Clarity | High Flow"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFF59D"
                android:padding="14dp"
                android:text="🟡 Sacred Spring — Moderate Zone\nMedium Clarity | Normal Flow"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#D7CCC8"
                android:padding="14dp"
                android:text="🔴 Stream B — Pollution Alert\nLow Clarity | Low Flow"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- LEGEND -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Legend"
                android:textStyle="bold"
                android:textColor="#0B5D3B"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔵 Clean Water Zone"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟡 Moderate Risk Zone"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 Pollution Alert Zone"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- FLOATING BUTTON -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNav"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:backgroundTint="#7E57C2"
        app:srcCompat="@android:drawable/ic_input_add" />

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>